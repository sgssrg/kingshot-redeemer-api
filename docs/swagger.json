{
    "swagger": "2.0",
    "info": {
        "description": "API for redeeming KingShot gift codes on behalf of registered players. OpenAPI spec served at /api/openapi.json for import into GitBook.",
        "title": "Kingshot Redeem API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8081",
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Returns \"Hello, World!\" to confirm the service is running.",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Hello, World!",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/player/add": {
            "post": {
                "description": "Adds a new player to the database. When KSFetchAvailable is enabled, profile data is fetched from the KingShot API; otherwise only the provided fields are stored.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Player"
                ],
                "summary": "Add a player",
                "parameters": [
                    {
                        "description": "Player to add",
                        "name": "player",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.PlayerReqBody"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created Player examples\" examples(",
                        "schema": {
                            "$ref": "#/definitions/model.PlayerAPIResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid JSON or validation error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Unable to add the player",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/player/del/{pid}": {
            "delete": {
                "description": "Removes a player from the database by player ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Player"
                ],
                "summary": "Delete a player",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Player ID",
                        "name": "pid",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Player deleted\" example({\"pid\":123,\"deleted\":true})",
                        "schema": {
                            "$ref": "#/definitions/model.DeletePlayerResponse"
                        }
                    },
                    "500": {
                        "description": "Delete failed\" example({\"pid\":123,\"deleted\":false,\"error\":\"database error\"})",
                        "schema": {
                            "$ref": "#/definitions/model.DeletePlayerErrorResponse"
                        }
                    }
                }
            }
        },
        "/player/update": {
            "patch": {
                "description": "Loads all players from the database and update every single of them, streaming per-player results as Server-Sent Events (event: update-res) followed by a summary (event: update-fin) about the rows it replaced with recent information. Rate limited.",
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "Player"
                ],
                "summary": "Updates the Db with latest Player",
                "responses": {
                    "200": {
                        "description": "update-res and update-fin event\" example(event: update-res\\ndata: {\"updated\":true,\"player\":{\"pid\":123,\"kid\":789,\"dNname\":\"updated-player-name\",\"pfp\":\"\u003cupdated-player-pfp-url\u003e,\"alliance\":\"DES\"}}\\n\\n event: update-fin\\ndata: {\"count\":123 })",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/redeem/db": {
            "post": {
                "description": "Loads all players from the database and redeems the configured gift code for each one, streaming per-player results as Server-Sent Events (event: redeem-res) followed by a summary (event: redeem-fin). Rate limited.",
                "produces": [
                    "text/event-stream"
                ],
                "tags": [
                    "Redeem"
                ],
                "summary": "Redeem gift code for all players",
                "parameters": [
                    {
                        "type": "string",
                        "example": "KS0803",
                        "description": "Gift code",
                        "name": "code",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "redeem-res and redeem-fin event\" example(event: redeem-res\\ndata: {\"fid\":\"123\",\"code\":\"KS0803\",\"result\":{\"errCode\":20000,\"msg\":\"Redeemed\"},\"success\":true,\"time\":\"2026-08-07T22:05:40+05:30\"}\\n\\n event: redeem-fin\\ndata: {\"redeemed\":10,\"manual\":2,\"playerDead\":1,\"codeExpired\":3})",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/redeem/ws": {
            "get": {
                "description": "Upgrades the connection to a WebSocket and greets the client.",
                "tags": [
                    "Redeem"
                ],
                "summary": "WebSocket test",
                "responses": {
                    "101": {
                        "description": "Switching Protocols"
                    }
                }
            }
        },
        "/scraper/stratforge/{fid}": {
            "get": {
                "description": "Fetches player profile data from stratforge.tools by player FID (Fleet ID). Returns player display name, kingdom ID, alliance, and profile picture.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Scraper"
                ],
                "summary": "Scrape player profile from StratForge",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Player Fleet ID",
                        "name": "fid",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/model.ScrapePlayerInfo"
                        }
                    },
                    "409": {
                        "description": "Player ID doesn't exist",
                        "schema": {
                            "$ref": "#/definitions/model.CustomScrapePlayerErrInfo"
                        }
                    },
                    "500": {
                        "description": "Scraping failed or invalid Player ID",
                        "schema": {
                            "$ref": "#/definitions/model.CustomScrapePlayerErrInfo"
                        }
                    },
                    "502": {
                        "description": "Failed to fetch from stratforge.tools",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.CustomScrapePlayerErrInfo": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "pid": {
                    "type": "integer"
                },
                "type": {
                    "type": "integer"
                }
            }
        },
        "model.DeletePlayerErrorResponse": {
            "type": "object",
            "properties": {
                "deleted": {
                    "type": "boolean"
                },
                "error": {
                    "type": "string"
                },
                "pid": {
                    "type": "string"
                }
            }
        },
        "model.DeletePlayerResponse": {
            "type": "object",
            "properties": {
                "deleted": {
                    "type": "boolean"
                },
                "pid": {
                    "type": "string"
                }
            }
        },
        "model.PlayerAPIResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "player": {
                    "$ref": "#/definitions/model.PlayerInfo"
                },
                "type": {
                    "type": "integer"
                }
            }
        },
        "model.PlayerInfo": {
            "type": "object",
            "properties": {
                "alliance": {
                    "type": "string"
                },
                "dName": {
                    "type": "string"
                },
                "kid": {
                    "type": "integer"
                },
                "pfp": {
                    "type": "string"
                },
                "pid": {
                    "type": "integer"
                }
            }
        },
        "model.PlayerReqBody": {
            "type": "object",
            "required": [
                "kid",
                "pid"
            ],
            "properties": {
                "alliance": {
                    "type": "string"
                },
                "kid": {
                    "type": "integer",
                    "minimum": 1
                },
                "pid": {
                    "type": "string"
                }
            }
        },
        "model.ScrapePlayerInfo": {
            "type": "object",
            "properties": {
                "alliance": {
                    "type": "string"
                },
                "dName": {
                    "type": "string"
                },
                "kid": {
                    "type": "integer"
                },
                "pfp": {
                    "type": "string"
                },
                "pid": {
                    "type": "integer"
                }
            }
        }
    }
}